# Server MET v2.0 - Environment Configuration
# Copy this file to .env and adjust values

# NOAA GFS Download
NOAA_BASE_URL=https://nomads.ncep.noaa.gov/pub/data/nccf/com/gfs/prod/gfs.

# Database
SQLITE_DB_PATH=data/sqlite/met_data.db

# API Server
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Logging
LOG_LEVEL=INFO

# Scheduler
SCHEDULER_TIMEZONE=America/Sao_Paulo
PIPELINE_SCHEDULE_HOURS=0,6,12,18

# Paths (relative to project root)
GRIB_BASE_DIR=data/grib
MAPS_BASE_DIR=maps
CSV_EXPORT_DIR=data/csv