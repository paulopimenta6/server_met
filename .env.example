# Server MET v2.0 - Environment Configuration
# Copy this file to .env and adjust values

# NOAA GFS Download
NOAA_BASE_URL=https://nomads.ncep.noaa.gov/pub/data/nccf/com/gfs/prod/gfs.
NOAA_FILTER_URL=https://nomads.ncep.noaa.gov/cgi-bin/filter_gfs_0p25.pl
NOAA_FTP_URL=ftp://ftp.ncep.noaa.gov/pub/data/nccf/com/gfs/prod/gfs.

# AviationWeather METAR
AVIATION_WEATHER_URL=https://aviationweather.gov/api/data/metar

# Database
SQLITE_DB_PATH=data/sqlite/met_data.db

# API Server
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Logging
LOG_LEVEL=INFO